# Copy this file to ".env". Restart "npm run dev" after changing it.

# Where the backend runs. In production, e.g. https://api.yoursite.com
VITE_API_URL=http://localhost:5000

# Production only: your platform's domain, e.g. yoursite.com
VITE_ROOT_DOMAIN=

# Optional development shortcut: makes plain http://localhost:5173 open this
# gallery instead of the landing page. Leave it out to see the landing page.
# VITE_ORG_SLUG=test-gallery-a
